# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asalahub
DATABASE_URL=postgresql://postgres:postgres@db:5432/asalahub

# Backend configuration
ENVIRONMENT=development
ALLOWED_HOSTS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=CHANGE_THIS_TO_A_COMPLEX_SECRET_IN_PRODUCTION
CAMPUS_MODE=false
AUTO_SEED=false

# Backup configuration
RETENTION_DAYS=14

# Next.js Public environment variables (baked into static assets at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
